    { 
      "objclass": "NarrativeProperties",
      "aliases": [
        "TEMPORAL_Intro"
      ],
      "objdata": {
        "AutoAdvance": true,
        "DelayBetweenLines": 3,
        "Flow": [
          {
            "Character": "winnie",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "Sensors detect anomalous temporal flow in current sector",
              "zh": "探测器显示当前区域时间流速异常"
            },
            "Delay": 0.3
          },
          {
              "Character": "winnie",
              "Action": "SAY",
              "Lines": {
                  "en": "This may plunge us into a temporal recursion loop",
                  "zh": "这将导致我们陷入无限月读之中"
              },
              "Delay": 0.3
          },
          {
              "Character": "winnie",
              "Action": "SAY",
              "Lines": {
                  "en": "Neutralized hostile entities will reappear repeatedly, ultimately drawing us into the temporal current",
                  "zh": "那些被击杀的敌人会在眼前一次又一次重现，直到将我们拉进时间洪流之中"
              },
              "Delay": 0.3
          },
          {
              "Character": "winnie",
              "Action": "SAY",
              "Lines": {
                  "en": "However, do not panic. After the final wave, once no enemies remain on the field, we can terminate this cycle",
                  "zh": "但是不用惊慌，在最后一波袭击过后，一旦场上不存在任何敌人，我们就可以打破这个循环"
              },
              "Delay": 0.3
          },
          {
              "Character": "winnie",
              "Action": "SAY",
              "Lines": {
                  "en": "Now, execute your designated functions",
                  "zh": "现在，去做你该做的事"
              },
              "Delay": 0.3
          }
        ]
      }
    },
