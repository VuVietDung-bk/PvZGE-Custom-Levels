        "objdata": {
            "DescriptionsMultilanguage": [
            {
                "en": "All zombies gain +60% health, +60% attack damage, +60% armor durability, and -30% dynamic point requirement",
                "zh": "所有僵尸的生命值和攻击力和防具耐久度+60%，动态点数需求-30%"
            },
            {
                "en": "All Torch Abbot have reduced targeting range and flame duration, but gain significantly increased attack range and flame damage",
                "zh": "所有住持火把的索敌距离和喷火时间降低，但是攻击距离和火焰伤害大幅提升"
            },
            {
                "en": "All Imps gain +30% health and +30% attack damage, with enhanced special abilities",
                "zh": "所有小鬼的生命值和攻击力+30%，特殊能力提升"
            },
            {
                "en": "A moderate number of zombies are replaced with a small number of Strong Bronze Zombies. All Strong Bronze Zombies gain +30% movement speed and enrage more easily",
                "zh": "中量僵尸被替换为少量大汉铜人，所有大汉铜人的移动速度+30%且更容易狂暴"
            },
            {
                "en": "Some waves are modified, and certain plants are disabled",
                "zh": "部分波次有所不同，禁用部分植物"
            }
            ]
        }
