    { 
      "objclass": "NarrativeProperties",
      "aliases": [
        "TEMPORAL_Intro"
      ],
      "objdata": {
        "AutoAdvance": true,
        "DelayBetweenLines": 3,
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "PENNY! My Repeater got WHIRLY-WHIRLED away by the wind!",
              "zh": "潘妮，我的双发射手被狂风吹走了！"
            },
            "Delay": 0.3
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "The breeze here is just WAAAAAY too breezy-breezy!",
              "zh": "这儿的风实在是太太太太~~~大了！"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "Negative. This is not natural meteorological phenomenon",
              "zh": "那可不是自然原因导致的"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "Sensors detect a group of combat monks practicing ritual fan maneuvers in proximity",
              "zh": "探测器显示有一群武僧在附近练习舞扇"
            },
            "Delay": 0.3
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "Holy tacos! Make them stop! Forget about the twirling troupe...",
              "zh": "天啊，让它们停下来，先不说跳舞的家伙怎么样"
            },
            "Delay": 0.3
          },
          {
            "Character": "crazydave",
            "Action": "SHOUT",
            "Lines": {
              "en": "WHO uses such EAR-SPLITTING gongs for background music ANYWAY?!",
              "zh": "谁会用这么烦人的铜锣声当背景音乐啊！！！"
            },
            "Delay": 0.3
          }
        ]
      }
