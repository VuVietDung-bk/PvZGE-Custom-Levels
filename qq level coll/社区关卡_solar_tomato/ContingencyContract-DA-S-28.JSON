      "objdata": {
        "DescriptionsMultilanguage": [
          {
            "en": "All zombies except Imp Gargantuars gain +100% health and attack damage, +20% movement speed, +100% armor durability, and -20% dynamic point requirement",
            "zh": "除巨人投掷的小鬼外所有僵尸的生命值和攻击力+100%，移动速度+20%，防具耐久度+100%，动态点数需求-20%"
          },
          {
            "en": "All King Veterans no longer grant armor to level 4 armor zombies, gain +50% health, and have increased armor granting speed",
            "zh": "所有精英国王不再为四级防具僵尸授勋，生命值+50%，授勋速度提升"
          },
          {
            "en": "All Wizard Veterans have -50% movement speed but gain +60% health, and have increased spellcasting speed",
            "zh": "所有精英法师的移动速度-50%，但是生命值+60%，施法速度提升"
          },
          {
            "en": "Additional Sun Gravestones appear with significantly increased quantity",
            "zh": "额外出现阳光墓碑但是数量大幅提升"
          },
          {
            "en": "Invisibility Potions spawn rate and maximum quantity are increased, and other potions spawn rate and initial quantity are increased",
            "zh": "隐形药水的出现速度和最大数量提升，其他药水的出现速度和初始数量提升"
          }
        ]
      }
