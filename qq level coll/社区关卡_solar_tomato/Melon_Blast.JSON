    { 
      "objclass": "NarrativeProperties",
      "aliases": [
        "Cantaloupe_Intro"
      ],
      "objdata": {
        "AutoAdvance": true,
        "DelayBetweenLines": 3,
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "SUMMER'S the ULTIMATE melon-munching season, neighborino!",
              "zh": "夏季是最适合吃瓜的季节"
            },
            "Delay": 0.3
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "Pair it with a taco-flavored taco and it's ABSOLUTELY TACO-TASTIC!",
              "zh": "配上一个塔克味玉米卷，绝对是一场狂欢！"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
                "en": "User Dave wishes to provide you with melon seedlings. Please nurture them appropriately",
                "zh": "用户戴夫想送一些瓜苗给你，好好呵护它们"
            },
            "Delay": 0.3
          },
          {
            "Character": "zombossicon",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
                "en": "Time-zippers, enjoy your final summer party while you still possess a functioning brain",
                "zh": "时空旅行者，享受有脑时的最后派对吧"
            },
            "Delay": 0.3
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
                "en": "Looking for your pea-firing friends to attack me? How unfortunate... they've been expunged from your inventory in this particular reality continuum",
                "zh": "想找你的豌豆朋友攻击我？抱歉，在这条世界线上它们不存在于你的仓库里"
            },
            "Delay": 0.3
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
                "en": "Your deranged neighbor couldn't resist his craving for summer melons, so he traded ALL your offensive plant seeds to me",
                "zh": "你那疯子邻居无法忍受对夏日吃瓜的渴求，便用所有攻击性植物的种子和我达成交易"
            },
            "Delay": 0.3
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
                "en": "If you dare counterattack with the melon seedlings from our trade, my personal jester will return every melon they throw right back at you",
                "zh": "如果你妄图使用交易得来的瓜苗反戈一击，我的贴身弄臣会将其如数奉还"
            },
            "Delay": 0.3
          },
          {
            "Character": "zombossicon",
            "Action": "NPC_EXIT",
            "Delay": 0.5
          },              
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
                "en": "OH NO, NEIGHBOR! I made a COLOSSAL oopsie!",
                "zh": "天啊邻居，我犯了一个巨大的错误"
            },
            "Delay": 0.3
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
                "en": "I forgot to give the Repeater to that doctor! I swear on the holy taco, I didn't mean to break the deal!",
                "zh": "我忘了把双发射手给那个博士了，以玉米卷之名，我不是故意违约的"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
                "en": "According to scans, the Cantaloupe provided by Dr. Zomboss contain immense energy",
                "zh": "检测结果显示，僵尸博士送来的哈密瓜拥有巨大的能量"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
                "en": "This energy enables the Cantaloupe to detonate upon impact, effectively striking zombies",
                "zh": "这些能量足以使哈密瓜在投掷出去时瞬间炸开，轰击僵尸"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
                "en": "Utilize Dr. Zomboss's generous gift appropriately and reduce his jokers to melon pulp",
                "zh": "妥善利用僵尸博士赠予我们的大礼，把他的小丑打得稀里瓜啦"
            },
            "Delay": 0.3
          }
          
        ]
      }
    },
