    {
      "aliases": [
        "BeatTheLevel"
      ],
      "objclass": "StarChallengeBeatTheLevelProps",
      "objdata": {
        "DescriptionsMultilanguage": [
          {
            "en": "All zombies have -25% movement speed but gain +150% health, +50% attack damage, and +30% armor durability",
            "zh": "所有僵尸的移动速度-25%，但是生命值+150%，攻击力+50%，防具耐久度+30%"
          },
          {
            "en": "All Relic Hunter have -30% health but gain +80% attack damage, and land at column 4",
            "zh": "所有遗迹猎人的生命值-30%，但是攻击力+80%，落地位置固定为4列"
          },
          {
            "en": "All Imp Porter gain +200% attack damage and movement speed",
            "zh": "所有搬运小鬼的攻击力和移动速度+200%"
          },
          {
            "en": "Some Crystal Skull are equipped with fragile level 2 armor, gain +60% movement speed, and have reduced attack range and charge cooldown;Some Crystal Skull have -20% movement speed but gain +160% health, and have increased attack range and charge time",
            "zh": "部分考古学家携带脆弱二级防具，移动速度+60%，攻击距离和蓄力冷却时间缩短；部分考古学家的移动速度-20%，但是生命值+160%，攻击距离和蓄力时间变长"
          },
          {
            "en": "Some waves and dynamic spawning are modified, with certain plants disabled",
            "zh": "部分波次和动态出怪有所不同，禁用部分植物"
          }
        ]
      }
