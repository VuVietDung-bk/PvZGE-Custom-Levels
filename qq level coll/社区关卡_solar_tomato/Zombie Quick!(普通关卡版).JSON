    { 
      "objclass": "NarrativeProperties",
      "aliases": [
        "ZQ_Intro"
      ],
      "objdata": {
        "AutoAdvance": true,
        "DelayBetweenLines": 3,
        "Flow": [
          {
            "Character": "zombossicon",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "en": "Life is like a box of assorted brains, you never know what you're gonna get.",
              "zh": "人生就像一盒各式各样的大脑，你永远不知道下一块将会是哪种。"
            },
            "Delay": 0.3
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "en": "You know it's funny what a young mind remembers. I remember my first brain... ",
              "zh": "你知道年幼的心灵会记住什么有趣的事吗？我记得我的第一个大脑..."
            },
            "Delay": 0.3
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "en": "From that day on, if I was going somewhere, I WAS RUNNING!",
              "zh": "从那天起，如果我要去某个地方，我都是跑着去的！"
            }
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "en": "The zombies are coming! The zombies are coming! And this time, we're not stopping for tea!",
              "zh": "僵尸来了！僵尸来了！而这次，我们可不会停下来喝茶！"
            },
            "Delay": 0.3
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
              "en": "Death is a part of life. I'm just making sure it's a BIG part of YOURS!",
              "zh": "死亡是生命的一部分。我只是要确保它成为你们生命中很重要的一部分！"
            },
            "Delay": 0.3
          }
        ]
      }
