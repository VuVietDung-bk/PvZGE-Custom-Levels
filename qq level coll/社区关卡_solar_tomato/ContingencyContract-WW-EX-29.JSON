        "DescriptionsMultilanguage": [
          {
            "en": "All zombies except Imps gain +150% health and movement speed, +200% armor durability, and -25% dynamic point requirement",
            "zh": "除小鬼外所有僵尸的生命值和移动速度+150%，防具耐久度+200%，动态点数需求-25%"
          },
          {
            "en": "All Piano have -70% movement speed but gain +150% attack damage and health",
            "zh": "所有钢琴僵尸的移动速度-70%，但是攻击力和生命值+150%"
          },
          {
            "en": "All West Bull gain +200% attack damage and +50% health",
            "zh": "所有机械牛的攻击力+200%，生命值+50%"
          },
          {
            "en": "All Prospector immediately relocate to the backline upon entry and do not linger, with +100% health and attack damage",
            "zh": "所有淘金僵尸入场后立刻转移到后场且不再停留，生命值和攻击力+100%"
          },
          {
            "en": "Some waves and dynamic spawning are modified, with certain plants disabled",
            "zh": "部分波次和动态出怪有所不同，禁用部分植物"
          },
          {
            "en": "Magnifying Grass damage significantly increased, but consumes more sun",
            "zh": "棱镜草攻击力大幅提升，消耗更多阳光"
          }
        ]
