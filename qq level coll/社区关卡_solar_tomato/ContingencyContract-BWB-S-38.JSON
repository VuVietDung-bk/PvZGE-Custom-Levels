      "objdata": {
        "DescriptionsMultilanguage": [
          {
            "en": "All zombies except Imp Gargantuars gain +40% health and attack damage, +20% movement speed, and -30% dynamic point requirement",
            "zh": "除巨人投掷的小鬼外所有僵尸的生命值和攻击力+40%,移动速度+20%,动态点数需求-30%"
          },
          {
            "en": "All Surfer have -25% movement speed but gain +300% attack damage, +100% health, and +50% surfboard durability",
            "zh": "所有冲浪僵尸的移动速度-25%，但是攻击力+300%，生命值+100%，冲浪板耐久度+50%"
          },
          {
            "en": "All Surfer Veterans have -20% health but gain +30% movement speed, increased surfing speed, and +200% iron surfboard durability",
        "zh": "所有精英冲浪僵尸的生命值-20%，但是移动速度+30%，冲浪倍速提升，铁质冲浪板耐久度+200%"
          },
          {
            "en": "All Gargantuars have -20% movement speed but gain +30% health, moving slower when ashore but with higher damage reduction",
            "zh": "所有巨人的移动速度-20%，但是生命值+30%,上岸时移速更慢但减伤幅度更高"
          },
          {
            "en": "Special Fisherman appear additionally in the first large wave, with altered shoreline layout",
            "zh": "第一个大波额外出现特殊钓鱼僵尸，海岸线有所不同"
          }
        ]
      }
