        "DescriptionsMultilanguage": [
          {
            "en": "All zombies have -10% movement speed but gain +60% health and attack damage, and +100% armor durability",
            "zh": "所有僵尸的移动速度-10%，但是生命值和攻击力+60%，防具耐久度+100%"
          },
          {
            "en": "All level 3 armor zombies have -10% movement speed, but armor is no longer considered ice",
            "zh": "所有三级防具僵尸的移动速度-10%，但是防具不再视为冰"
          },
          {
            "en": "All Hunter gain +50% health, increased attack range, reduced throw count but projectiles are replaced with Winter Melons",
            "zh": "所有猎人僵尸的生命值+50%，攻击范围提升，投掷数量降低但是投掷物替换为冰西瓜"
          },
          {
            "en": "All Dodo gain +70% health and +250% attack damage, and will take off when encountering more plant types",
            "zh": "所有渡渡鸟骑手的生命值+70%，攻击力+250%，会在遇到更多种植物时起飞"
          },
          {
            "en": "Slider positions are altered, and Frost Wind mechanics are modified",
            "zh": "浮冰位置变化，冰风有所不同"
          }
        ]
