      "objdata": {
        "DescriptionsMultilanguage": [
          {
              "en": "All zombies gain +100% attack damage. All Imps gain +50% movement speed",
              "zh": "所有僵尸的攻击力+100%，所有小鬼的移动速度+50%"
          },
          {
              "en": "All Raptor have reduced movement range, but increased kick distance, kick edge moved backward, gain increased movement speed",
              "zh": "所有迅猛龙的活动范围缩小，但踢击距离提升，踢击底线后移，移动速度提升"
          },
          {
              "en": "All Stego have reduced toss distance and increased toss time, but carry more zombies and have significantly increased loitering time",
              "zh": "所有剑龙的投掷距离缩短，投掷时间提升，但是负载僵尸数量提升，徘徊时间大幅提升"
          },
          {
              "en": "Some waves and dinosaur spawn positions are modified",
              "zh": "部分波次和恐龙位置有所不同"
          },
          {
              "en": "Mold appears on the field, and certain plants are disabled",
              "zh": "场上出现霉菌，禁用部分植物"
          }
        ]
      }
