    { 
      "objclass": "NarrativeProperties",
      "aliases": [
        "TEMPORAL_Intro"
      ],
      "objdata": {
        "AutoAdvance": true,
        "DelayBetweenLines": 3,
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "Repeater has submitted a request to assume command of our defensive operations for one solar cycle",
              "zh": "双发射手请求代理我们的植物防线一天"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "It hopes to demonstrate its combat efficacy in a single engagement",
              "zh": "它希望能在这次战斗中证明自己的价值"
            },
            "Delay": 0.3
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "Oh Penny, we've got plants that are FOUR PEAS better than that double-shooter fella!",
              "zh": "哦潘妮，我们有比那个两发射手好四颗豌豆的家伙"
            },
            "Delay": 0.3
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "So let's make it an eighth-of-a-day plant commander! That's TACO-MATH for you!",
              "zh": "所以，让它当八分之一天的植物头头吧"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "Your mathematical prowess appears equivalent to firing two peas simultaneously, User Dave",
              "zh": "你的计算能力堪比同时发射两颗豌豆，用户戴夫"
            },
            "Delay": 0.3
          }
        ]
      }
