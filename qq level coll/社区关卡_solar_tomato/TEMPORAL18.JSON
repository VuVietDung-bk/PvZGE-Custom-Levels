    { 
      "objclass": "NarrativeProperties",
      "aliases": [
        "TEMPORAL_Intro"
      ],
      "objdata": {
        "AutoAdvance": true,
        "DelayBetweenLines": 3,
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "Such sparkly-sparkly gems! They're as rare as limited edition waffles!",
              "zh": "多么晶莹剔透的宝石，它们和限量版华夫饼一样稀有！"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "Magnifying Grass specimens can absorb solar radiation and discharge it as concentrated energy",
              "zh": "棱镜草可以吸收太阳光并将其发射出去"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "They represent the optimal countermeasure against elusive hostile entities",
              "zh": "如果要对付神出鬼没的敌人，它们是最佳选择"
            },
            "Delay": 0.3
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "Whoa! That sounds way more dangerous than waffles!",
              "zh": "哇，听上去比华夫饼还危险"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "Please refrain from feigning recent acquaintance with these botanical units, User Dave",
              "zh": "请不要装作刚刚才认识它们的样子，用户戴夫"
            },
            "Delay": 0.3
          }
        ]
      }
    },
