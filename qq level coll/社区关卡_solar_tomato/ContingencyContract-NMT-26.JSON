      "objdata": {
        "DescriptionsMultilanguage": [
          {
              "en": "All zombies except Imp Gargantuars gain +80% health and armor durability, and +30% movement speed",
              "zh": "除巨人投掷的小鬼外所有僵尸的生命值和防具耐久度+80%，移动速度+30%"
          },
          {
              "en": "All Arcade Zombies gain +30% health and movement speed, and all 8bit Zombies gain +60% movement speed and attack damage",
              "zh": "所有街机推手的生命值和移动速度+30%，所有8bit僵尸的移动速度和攻击力+60%"
          },
          {
              "en": "All MC and Breakdancer gain +60% health. Breakdancer have increased kick range and cooldown",
              "zh": "所有说唱僵尸和霹雳舞僵尸的生命值+60%，霹雳舞僵尸的踢击距离和冷却时间增加"
          },
          {
              "en": "More protected plants appear",
              "zh": "出现更多需要保护的植物"
          },
          {
              "en": "'POP' and '8bit' music effects are active by default, and some waves and music are modified",
              "zh": "场上默认存在'POP'和'8bit'音乐效果，部分波次和音乐有所不同"
          }
        ]
      }
