        "objdata": {
            "DescriptionsMultilanguage": [
            {
                "en": "All zombies gain +120% movement speed and -30% dynamic point requirement",
                "zh": "所有僵尸的移动速度+120%，动态点数需求-30%"
            },
            {
                "en": "Some Chi Abbot are equipped with level 3 armor and projectiles are replaced with special sound waves; some Chi Abbot gain +100% health and have reduced wave charge time",
                "zh": "部分气功住持携带三级防具且发射物改为特殊音波；部分气功住持的生命值+100%且发波时间缩短"
            },
            {
                "en": "All Fan Abbot have -30% movement speed, but have reduced whirlwind cooldown, increased whirlwind distance and reduced duration",
                "zh": "所有折扇住持的移动速度-30%，但是旋风释放间隔缩短，旋风距离提升且持续时间缩短"
            },
            {
                "en": "All 3-Section Staff Abbot have reduced multi-hit damage, but gain increased dash distance and reflected projectile damage",
                "zh": "所有三节棍住持的多段伤害降低，但是突进距离和子弹反弹伤害提升"
            },
            {
                "en": "Some waves are modified, and certain plants are disabled",
                "zh": "部分波次有所不同，禁用部分植物"
            }
            ]
        }
