          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "Our seed storage facility is obstructed by improperly parked football mech",
              "zh": "我们的种子仓库被随意停放的橄榄球机器堵塞了"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "User Dave is currently engaged in clearing these 'zombie vehicles'. Operational capacity estimated to resume in 23.23 hours",
              "zh": "用户戴夫正在花时间清理这些“僵尸车”，预计23.23小时后可以恢复运行"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
                "en": "However, zombies will not accommodate our cleanup schedule. Please utilize the expendable seeds stockpiled outside the warehouse to repel this assault",
                "zh": "但僵尸不会配合我们的清理计划，所以请利用这些仓库外堆放的一次性种子抵抗这次进攻"
            },
            "Delay": 0.3
          }
        ]
      }
