    { 
      "objclass": "NarrativeProperties",
      "aliases": [
        "TEMPORAL_Intro"
      ],
      "objdata": {
        "AutoAdvance": true,
        "DelayBetweenLines": 3,
        "Flow": [
          {
            "Character": "zombossicon",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
                "en": "Everything you hold dear shall be obliterated - this timeline is being rewritten to my design!",
                "zh": "你们所熟知的一切都将被摧毁，这条时间线正在被改写"
            },
            "Delay": 0.3
          },
          {
            "Character": "zombossicon",
            "Action": "SAY",
            "Lines": {
                "en": "Surrender your brains to me now, before you inevitably bungle your brains!",
                "zh": "在你们葬送自己之前，将大脑奉献于我！"
            },
            "Delay": 0.3
          },
          {
            "Character": "zombossicon",
            "Action": "NPC_EXIT",
            "Delay": 0.5
          },
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "crazydave",
            "Action": "SHOUT",
            "Lines": {
              "en": "HOLY TACOS, Penny! Did you hear that?! He's gonna DESTROY our front yard!",
              "zh": "我的天啊，你听见了吗潘妮，他要毁了我们的前院！"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "The situation is more dire than that, User Dave",
              "zh": "比这更糟，用户戴夫"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
                "en": "We must prepare to evacuate this timeline entirely",
                "zh": "我们需要准备逃出这条时间线"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
                "en": "Please maintain battlefield control for 5 minutes. Do not allow zombies to approach our activation device",
                "zh": "请在战场上坚持5分钟，别让僵尸靠近我们的启动设备"
            },
            "Delay": 0.3
          }
        ]
      }
