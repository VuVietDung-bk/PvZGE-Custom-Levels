        "DescriptionsMultilanguage": [
          {
              "en": "All zombies gain +50% health, +50% attack damage, and +50% armor durability",
              "zh": "所有僵尸的生命值，攻击力和防具耐久度+50%"
          },
          {
              "en": "All Bully have -20% movement speed but gain +70% health and +70% attack damage, and their attack mode is altered",
              "zh": "所有野人僵尸的移动速度-20%，但是生命值和攻击力+70%，攻击方式转变"
          },
          {
              "en": "All Ptero gain increased flight speed and can carry multiple zombies and Imps",
              "zh": "所有翼龙的飞行速度提升，可携带多个僵尸和小鬼"
          },
          {
              "en": "All Tyranno have increased roar count, and other dinosaurs' special abilities receive minor enhancements",
              "zh": "所有霸王龙的吼叫次数提升，其他恐龙的特殊能力少量强化"
          },
          {
              "en": "Some waves and dinosaur spawn positions are modified, and some plants are weakened",
              "zh": "部分波次和恐龙位置有所不同，削弱部分植物"
          }
        ]
      }
