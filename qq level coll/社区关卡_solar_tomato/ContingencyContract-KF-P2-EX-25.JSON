        "objdata": {
            "DescriptionsMultilanguage": [
            {
                "en": "All normal zombies gain +100% movement speed and +100% armor durability, and all special zombies gain +80% health and +80% attack damage",
                "zh": "所有普通僵尸的移动速度和防具耐久度+100%，特殊僵尸的生命值和攻击力+80%"
            },
            {
                "en": "All Drink Monk are more likely to drink, receive reduced damage while drinking, and gain increased attack damage, movement speed and damage reduction when intoxicated",
                "zh": "所有醉酒武僧更容易喝酒，喝酒时受到的伤害降低，醉酒状态下攻击力，移动速度和减伤增加"
            },
            {
                "en": "All Nunchaku Monk and Torch Monk gain +40% health and +40% movement speed. Nunchaku Monk Zombies have increased parry duration and reflected projectile damage",
                "zh": "所有双截棍武僧和火把武僧的生命值和移动速度+40%，双截棍反弹时间和反弹子弹伤害提升"
            },
            {
                "en": "Additional Kongfu Racks appear, some zombies emerge from under Kongfu Racks during certain waves, and certain plants are disabled",
                "zh": "出现额外兵器架，一些僵尸会在部分波次从兵器架下出现，禁用部分植物"
            }
            ]
        }
