      "objdata": {
        "DescriptionsMultilanguage": [
          {
            "en": "All zombies except Disco Jetpack have -10% movement speed but gain +200% attack damage and health, +50% armor durability, and -30% dynamic point requirement",
            "zh": "除喷气迪斯科僵尸外所有僵尸的移动速度-10%，但是攻击力和生命值+200%，防具耐久度+50%，动态点数需求-30%"
          },
          {
            "en": "All Mech enemies have -25% movement speed but gain +100% attack damage and health, with reduced EMPea effect duration; these effects are 1.5 times more effective on Disco Mechs, which also summon Disco Jetpacks more frequently",
            "zh": "所有机甲敌人的移动速度-25%，但是攻击力和生命值+100%，被脉冲黄桃影响时间减少；加成对迪斯科机甲的效果为1.5倍，召唤喷气迪斯科僵尸的频率提升"
          },
          {
            "en": "Some waves and dynamic spawning are modified",
            "zh": "部分波次和动态出怪有所不同"
          },
          {
            "en": "Mold quantity and positions are altered, with additional Power Tiles appearing that can respond to special level events",
            "zh": "霉菌数量和位置变化，额外出现可响应特殊关卡事件的瓷砖"
          }
        ]
      }
