        "DescriptionsMultilanguage": [
          {
            "en": "All zombies except Parrots, Imps and Raiding Party Swashbuckler gain +150% health and attack damage, +10% movement speed, and -40% dynamic point requirement",
            "zh": "除鹦鹉，小鬼和掠夺事件的飞索僵尸外所有僵尸的生命值和攻击力+150%,移动速度+10%，动态点数需求-40%"
          },
          {
            "en": "All Cannons have significantly reduced maximum imp capacity, enhanced death effect imp quantity",
            "zh": "所有小鬼加农炮的小鬼最大数量大幅降低，炸膛小鬼数量提升"
          },
          {
            "en": "All non-Raiding Party Swashbuckler land two tiles forward, and Seagull gain +100% attack damage",
            "zh": "所有非掠夺事件出现的飞索僵尸落地位置前移二格，海鸥僵尸的攻击力+100%"
          },
          {
            "en": "All Gargantuars and Barrelroller gain +80% movement speed and health",
            "zh": "所有巨人和滚筒僵尸的移动速度和生命值+80%"
          },
          {
            "en": "Dynamic zombie spawning is modified, with certain plants disabled",
            "zh": "动态出怪有所不同，禁用部分植物"
          }
        ]
      }
    },
