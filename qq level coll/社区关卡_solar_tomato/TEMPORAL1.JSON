    { 
      "objclass": "NarrativeProperties",
      "aliases": [
        "TEMPORAL_Intro"
      ],
      "objdata": {
        "AutoAdvance": true,
        "DelayBetweenLines": 3,
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "AAAAAAH, TACOS!",
              "zh": "啊啊啊啊，玉米卷"
            },
            "Delay": 0.3
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "OH HO HO HO OOOOOOH~~~~",
              "zh": "哦齁齁齁哦哦哦哦哦~~~~"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "Do not be concerned about User Dave's physical condition. He is experiencing temporary psychosis due to high-intensity wormhole traversal",
              "zh": "不用担心用户戴夫的身体状况，他只是经历高强度虫洞穿梭后有些精神错乱"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
                "en": "Returning to primary subject: we are currently situated at an unstable temporal junction",
                "zh": "言归正传，我们现在处于一个混乱的时间节点"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
                "en": "Dr. Zomboss is exploiting temporal rifts to deploy significant zombie forces in this location, attempting to acquire all resources",
                "zh": "僵尸博士利用时空裂缝在这里投放了大量僵力，试图夺走一切"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
                "en": "However, they cannot engage us indefinitely. I can utilize this junction's unstable properties to eliminate them",
                "zh": "但它们无法纠缠我们太久，我可以利用该节点的不稳定特性将它们抹杀"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
                "en": "Please complete the following training exercises. They will improve your survival probability in this hazardous zone",
                "zh": "现在请完成一些教学任务，它们有利于你提高在这片是非之地的存活率"
            },
            "Delay": 0.3
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "TACOS~~",
              "zh": "玉米卷~~"
            },
            "Delay": 0.3
          }
        ]
      }
    },
