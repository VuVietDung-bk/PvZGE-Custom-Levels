      "objdata": {
        "DescriptionsMultilanguage": [
          {
            "en": "All zombies except Imp Gargantuars gain +200% health and attack damage, and +100% armor durability",
            "zh": "除巨人投掷的小鬼外所有僵尸的生命值和攻击力+200%，防具耐久度+100%"
          },
          {
            "en": "All Gargantuars have reduced laser damage but significantly increased duration, +100% movement speed, and +30% health",
            "zh": "所有巨人的激光攻击力降低，但是持续时间大幅增加，移动速度+100%，生命值+30%"
          },
          {
            "en": "All Jetpack Veteran gain +100% movement speed and attack damage",
            "zh": "所有喷气宇航员僵尸的移动速度和攻击力+100%"
          },
          {
            "en": "All Imps have -50% movement speed and increased EMPea effect duration, but gain +200% attack damage and +80% health",
            "zh": "所有小鬼的移动速度-50%，被脉冲黄桃影响时间增加，但是攻击力+200%，生命值+80%"
          },
          {
            "en": "Some waves and dynamic spawning are modified, with certain plants disabled",
            "zh": "部分波次和动态出怪有所不同，禁用部分植物"
          }
    
        ]
