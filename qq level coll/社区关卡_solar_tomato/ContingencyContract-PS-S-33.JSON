      "objclass": "StarChallengeBeatTheLevelProps",
      "objdata": {
        "DescriptionsMultilanguage": [
          {
            "en": "All zombies except Parrots, Imps and Raiding Party Swashbuckler gain +200% health and attack damage, +30% movement speed, +250% armor durability, and -50% dynamic point requirement",
            "zh": "除鹦鹉，小鬼和掠夺事件的飞索僵尸外所有僵尸的生命值和攻击力+200%,移动速度+30%，防具耐久度+250%,动态点数需求-50%"
          },
          {
            "en": "All Cannons have massively increased maximum imp capacity, significantly faster firing rate, and +50% health",
            "zh": "所有小鬼加农炮的小鬼最大数量超大幅提升，开炮速度大幅提升，生命值+50%"
          },
          {
            "en": "All non-Raiding Party Swashbuckler land one tile forward, gain +120% attack damage",
            "zh": "所有非掠夺事件出现的飞索僵尸落地位置前移一格，攻击力+120%,动态点数需求-20%"
          },
          {
            "en": "All Pelican gain +80% health, attack damage and movement speed",
            "zh": "所有鹈鹕僵尸的生命值，攻击力和移动速度+80%"
          },
          {
            "en": "Some waves and dynamic spawning are modified, with plant food and certain plants disabled",
            "zh": "部分波次和动态出怪有所不同，禁用叶绿素和部分植物"
          }
        ]
      }
    },
