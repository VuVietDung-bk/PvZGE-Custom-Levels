      "objdata": {
        "DescriptionsMultilanguage": [
          {
            "en": "All zombies gain +120% health and attack damage, +20% movement speed, +150% armor durability but all armor is treated as ice",
            "zh": "所有僵尸的生命值和攻击力+120%，移动速度+20%，防具耐久度+150%但所有防具均视为冰"
          },
          {
            "en": "All Hunter and Hunter Veteran have reduced throwing speed and projectiles are replaced with different Winter Melon variants",
            "zh": "所有猎人和精英猎人的投掷速度降低且投掷物替换为不同的冰西瓜"
          },
          {
            "en": "All Troglobite and Troglobite Veteran gain +40% health and movement speed, with ice blocks containing different zombie types",
            "zh": "所有推冰僵尸和精英推冰僵尸的生命值和移动速度+40%，冰块包含的僵尸种类不同"
          },
          {
            "en": "All Weasel Hoarder release weakened versions of themselves (once only), with reduced release time",
            "zh": "所有养鼬人释放的冰鼬变为弱化的自身（仅一次），释放时间缩短"
          },
          {
            "en": "Dynamic spawning is modified, additional Frost Wind appears, and plants/zombies frozen in initial ice blocks are different",
            "zh": "动态出怪有所不同，额外出现冰风，初始冰块冻住的植物和僵尸有所不同"
          }
        ]
      }
