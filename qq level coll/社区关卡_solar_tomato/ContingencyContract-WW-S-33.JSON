      "objclass": "StarChallengeBeatTheLevelProps",
      "objdata": {
        "DescriptionsMultilanguage": [
          {
            "en": "All zombies except Chickens and Imps gain +150% health and attack damage,+130% armor durability,-30% dynamic point requirement",
            "zh": "除鸡和小鬼外所有僵尸的生命值和攻击力+150%，防具耐久度+130%，动态点数需求-30%"
          },
          {
            "en": "All Chicken Farmer gain +300% movement speed, release chickens more easily, have significantly extended release duration",
            "zh": "所有鸡贼僵尸的移动速度+300%，更容易释放鸡，释放时间大幅延长"
          },
          {
            "en": "All West Bull gain +50% health and attack damage with increased imp throwing distance, Bull Veterans gain +50% movement speed and reduced charge cooldown",
            "zh": "所有机械牛的生命值和攻击力+50%，投掷小鬼距离增加，精英机械牛的移动速度+50%，冲撞间隔缩短"
          },
          {
            "en": "Additional special zombies appear on all rail during the first two large waves",
            "zh": "额外在前2个大波的所有矿道上出现特殊僵尸"
          },
          {
            "en": "All Prospector gain +200% attack damage and are equipped with level 1 armor",
            "zh": "所有淘金僵尸的攻击力+200%，携带1级防具"
          },
          {
            "en": "Some waves feature modified zombie spawns",
            "zh": "部分波次出怪有所不同"
          }
        ]
      }
