            "objclass": "StarChallengeBeatTheLevelProps",
            "objdata": {
                "DescriptionsMultilanguage": [
                {
                    "en": "All zombies except Imp Gargantuars have -20% movement speed but gain +120% health, +120% attack damage, +120% armor durability, and -20% dynamic point requirement",
                    "zh": "除巨人投掷的小鬼外所有僵尸的移动速度-20%，但是生命值，攻击力和防具耐久度+120%，动态点数需求-20%"
                },
                {
                    "en": "All Lostpilot gain +40% health, with landing timing varying between waves",
                    "zh": "所有空降兵的生命值+40%，不同波次空降兵落地的时间有所不同"
                },
                {
                    "en": "All Bug Zombies have -60% health and -60% armor durability but gain +180% movement speed and +180% attack damage, while their bugs gain +50% movement speed and +50% health",
                    "zh": "所有蜻蜓僵尸的本体生命值和防具耐久度-60%，但是移动速度和攻击力+180%，蜻蜓的移动速度和生命值+50%"
                },
                {
                    "en": "Some zombies emerge from gold tiles during certain waves",
                    "zh": "一些僵尸会在部分波次从黄金地砖出现"
                },
                {
                    "en": "Some waves are modified, with certain plants and plant food disabled",
                    "zh": "部分波次有所不同，禁用部分植物和叶绿素"
                }
                ]
            }
