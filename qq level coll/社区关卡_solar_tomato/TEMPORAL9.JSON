    { 
      "objclass": "NarrativeProperties",
      "aliases": [
        "TEMPORAL_Intro"
      ],
      "objdata": {
        "AutoAdvance": true,
        "DelayBetweenLines": 3,
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "DARN IT, Those pesky pests are having a taco-tastrophe in my garden again!",
              "zh": "哦该死，那些讨厌的家伙又在我的花园里发狂！"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "Soil aeration is a necessary procedure for sunflower cultivation, User Dave",
              "zh": "松土是种植向日葵的必要措施，用户戴夫"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "Perhaps the zombies possess agricultural comprehension as well",
              "zh": "或许僵尸们也懂得这个道理"
            },
            "Delay": 0.3
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "Hey, if they think bulldozers and pterodactyl beaks count as gardening tools...",
              "zh": "嘿，要是它们认为推土机和翼龙喙也能用来松土..."
            },
            "Delay": 0.3
          },
          {
            "Character": "crazydave",
            "Action": "SHOUT",
            "Lines": {
              "en": "THAT'S JUST NUTS!!! AND NOT THE TACO-FILLING KIND!!!",
              "zh": "那就太疯狂了！！！"
            },
            "Delay": 0.3
          }
        ]
      }
