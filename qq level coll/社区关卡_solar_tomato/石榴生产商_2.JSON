        "Flow": [
          {
            "Character": "winnie",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
                "en": "",
                "zh": "埃及黄沙漫天，我们带来的普通石榴在这里可能无法应对"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
                "en": "所幸培育基地为我们留下了当地石榴，它们可以种出更加适宜环境的植物",
                "zh": "所幸培育基地为我们留下了当地石榴，它们可以种出更加适宜环境的植物"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
                "en": "但需要注意的是，当我们前往下一个世界时，这些特殊石榴将无法带走",
                "zh": "但需要注意的是，当我们前往下一个世界时，这些特殊石榴将无法带走"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
                "en": "祝你好运",
                "zh": "祝你好运"
            },
            "Delay": 0.3
          }
        ]
      }
