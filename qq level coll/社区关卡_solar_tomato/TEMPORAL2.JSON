    { 
      "objclass": "NarrativeProperties",
      "aliases": [
        "TEMPORAL_Intro"
      ],
      "objdata": {
        "AutoAdvance": true,
        "DelayBetweenLines": 3,
        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "I was totally whoozy-woozy from the time travel yesterday, neighborino! Took me FOREVER to recover!",
              "zh": "我昨天指定是晕车了，好一阵才缓过来"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "Acidic comestibles can mitigate adverse effects caused by temporal displacement",
              "zh": "酸性食物可以缓解时光机带来的不良反应"
            },
            "Delay": 0.3
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "That's why I LOVE sweet potatoes - they're absolutely TUBER-RIFIC!",
              "zh": "这就是我喜欢甜薯的原因，它们太棒了"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
                "en": "User Dave, I calculate sweet potatoes would not appreciate your culinary assessment",
                "zh": "用户戴夫，我想甜薯们对你的评价不会太高兴的"
            },
            "Delay": 0.3
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "Oh Penny, you should see how zombies react to them!",
              "zh": "哦潘妮，你是没看见过僵尸对它的反应"
            },
            "Delay": 0.3
          },
          {
            "Character": "crazydave",
            "Action": "SHOUT",
            "Lines": {
              "en": "SOUR-SWEET BLAST-O-RAMA!",
              "zh": "酸甜得爆炸！"
            },
            "Delay": 0.3
          }
        ]
      }
    },
