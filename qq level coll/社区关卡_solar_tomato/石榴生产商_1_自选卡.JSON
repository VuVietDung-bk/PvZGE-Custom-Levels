        "Flow": [
          {
            "Character": "winnie",
            "Action": "NPC_ENTER",
            "Delay": 0.5
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
                "en": "欢迎来到石榴弹培育中心",
                "zh": "欢迎来到石榴弹培育中心"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
                "en": "在这里我们将无法直接种植植物，石榴种子是获得植物的唯一选择",
                "zh": "在这里我们将无法直接种植植物，石榴种子是获得植物的唯一选择"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
                "en": "不同品种的石榴能产出不同的植物种子，关于这点您可以查看简介获得相关信息",
                "zh": "不同品种的石榴能产出不同的植物种子，关于这点您可以查看简介获得相关信息"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
                "en": "尤其注意，播撒的种子极其脆弱且需要一定时间成长，成长时间随植物品种而定",
                "zh": "尤其注意，播撒的种子极其脆弱且需要一定时间成长，成长时间随植物品种而定"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
                "en": "两位基地工作的植物会协助您的播种工作，随着工作的进展会有更多高级石榴和协助人员加入您的行列",
                "zh": "两位基地工作的植物会协助您的播种工作，随着工作的进展会有更多高级石榴和协助人员加入您的行列"
            },
            "Delay": 0.3
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
                "en": "为了我们的未来，开始种植吧",
                "zh": "为了我们的未来，开始种植吧"
            },
            "Delay": 0.3
          }
        ]
