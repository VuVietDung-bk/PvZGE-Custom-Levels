      "objdata": {
        "DescriptionsMultilanguage": [
          {
            "en": "All zombies except Imp Gargantuars have -20% movement speed but gain +60% health, +60% attack damage, +60% armor durability, and -25% dynamic point requirement",
            "zh": "除巨人投掷的小鬼外所有僵尸的移动速度-20%，但是生命值，攻击力和防具耐久度+60%,动态点数需求-25%"
          },
          {
            "en": "All Octopus Zombies have -10% movement speed but gain +20% health and increased pet throw speed",
            "zh": "所有章鱼僵尸的移动速度-10%，但是生命值+20%，投掷章鱼速度提升"
          },
          {
            "en": "All Fisherman have -10% health but gain increased hook casting speed",
            "zh": "所有钓鱼僵尸的生命值-10%，但是抛出鱼钩的速度提升"
          },
          {
            "en": "All Surfer have -10% movement speed but gain significantly increased surfing speed and +60% surfboard durability",
            "zh": "所有冲浪僵尸的移动速度-10%，但是冲浪倍速大幅提升，冲浪板耐久度+60%"
          },
          {
            "en": "Some waves, dynamic spawning and shoreline layout are modified",
            "zh": "部分波次，动态出怪和海岸线有所不同"
          }
        ]
      }
    },
