      "objdata": {
        "DescriptionsMultilanguage": [
          {
            "en": "All zombies except chickens gain +50% health, attack damage and movement speed, +80% armor durability, and -25% dynamic point requirement",
            "zh": "除鸡外所有僵尸的生命值、攻击力和移动速度+50%，防具耐久度+80%，动态点数需求-25%"
          },
          {
            "en": "All Chicken Farmer gain +200% health and attack damage, have significantly extended release duration",
            "zh": "所有鸡贼僵尸的生命值和攻击力+200%，更容易释放鸡，释放时间大幅延长"
          },
          {
            "en": "All West Bull have -40% normal movement speed but gain +100% health and charge speed, with significantly increased imp throwing distance",
            "zh": "所有机械牛的常态速度-40%，但是生命值和奔跑速度+100%，投掷小鬼距离大幅增加"
          },
          {
            "en": "Additional special Piano spawn at (1,6), (3,7), (5,8) positions during each large wave",
            "zh": "额外在每个大波的(1,6)(3,7)(5,8)处额外出现特殊钢琴僵尸"
          },
          {
            "en": "Number of protected plants increased, initial plant slots reduced to 7",
            "zh": "保护植物增加，初始植物携带位减少至7"
          }
        ]
