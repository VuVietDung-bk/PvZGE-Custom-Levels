      "objclass": "StarChallengeBeatTheLevelProps",
      "objdata": {
        "DescriptionsMultilanguage": [
          {
              "en": "All zombies gain +150% health and attack damage, +100% armor durability, and -25% dynamic point requirement",
              "zh": "所有僵尸的生命值和攻击力+150%，防具耐久度+100%，动态点数需求-25%"
          },
          {
              "en": "All dinosaur attributes and special abilities receive varying degrees of enhancement; some dinosaur variants appear",
              "zh": "所有恐龙的属性和特殊能力不同程度提升，部分恐龙出现变种"
          },
          {
              "en": "All Bully Veterans gain +30% movement speed and leave permanent pits after smashing plants",
              "zh": "所有搏击者的移动速度+30%，砸击植物后将留下永久的坑"
          },
          {
              "en": "Tidal appear on the field, and protected plants appear (at least 3 must be protected)",
              "zh": "场上出现海浪，出现需要保护的植物(至少保护其中三株)"
          },
          {
              "en": "Some waves, dynamic spawning, and dinosaur positions are modified; an additional 3 waves are added; and certain plants are disabled or weakened",
              "zh": "部分波次，动态出怪和恐龙位置有所不同，额外添加3波，禁用和削弱部分植物"
          }
        ]
      }
