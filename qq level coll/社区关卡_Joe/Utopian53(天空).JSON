                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER",
                        "Delay": 0.5
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Penny, is there something wrong with our ship?",
                            "zh": "潘妮，我们的飞船出了什么问题吗？"
                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "We encountered severe convective weather",
                            "zh": "我们遭遇了强对流天气"
                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Obstacles encountered in the air must be cleared as soon as possible",
                            "zh": "必须尽快清除空中遇到的障碍物"
                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Otherwise our ship will crash!",
                            "zh": "否则我们的飞船将会因此坠毁！"
                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "No way",
                            "zh": "那可不行"
                        },
                        "Delay": 0.3
                    },
                    { 
                        "Character": "crazydave",
                        "Action": "SHOUT",
