        {
            "objclass": "NarrativeProperties",
            "aliases": [
                "UTOPIAN_Intro"
            ],
            "objdata": {
                "AutoAdvance": true,
                "DelayBetweenLines": 2.5,
                "Flow": [
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER",
                        "Delay": 0.5
                    },
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER",
                        "Delay": 0.5
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Penny, do you mean,'The black hole created by this strange-looking guy?'",
                            "zh": "潘妮，你的意思是“这个长得奇奇怪怪的家伙制造的黑洞吗？”"
                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Yes, we must defeat him as soon as possible",
                            "zh": "对，我们必须尽快打败他"
                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Hey, my neighbor, I'll leave it to you",
                            "zh": "嘿，我的邻居，这件事就交给你了"
                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Don't ask why",
                            "zh": "不要问为什么"
                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SHOUT",
                        "Lines": {
                            "en": "Because I'm crazy!",
                            "zh": "因为我已经疯了！"
                        },
                        "Delay": 0.3
                    }
                ]
            }
        },
        {
            "objclass": "NarrativeProperties",
            "aliases": [
                "UTOPIAN_Outro"
            ],
            "objdata": {
                "AutoAdvance": true,
                "DelayBetweenLines": 2.5,
                "Flow": [
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER",
                        "Delay": 0.5
                    },
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER",
                        "Delay": 0.5
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Great, we finally beat him!",
                            "zh": "太棒了，我们终于打败他了!"
                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "The detector shows that the black hole has left us and the place has returned to its previous calm",
                            "zh": "探测仪显示，黑洞离我们而去，这里也恢复了以往的平静"
                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Then let's hurry to the next space!",
                            "zh": "那我们赶紧前往下一个时空吧！"
                        },
                        "Delay": 0.3
                    }
                ]
            }
        },
