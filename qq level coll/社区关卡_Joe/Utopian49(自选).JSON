                        "Delay": 0.5
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "There is a serious disturbance in the magnetic field of Kongfu Temple",
                            "zh": "武林寺庙磁场出现严重扰动"
                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "It is estimated that the space-time black hole will log in four days later",
                            "zh": "据估算，时空黑洞即将4天后登录"
                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Are black holes 'feet off the ground'?",
                            "zh": "黑洞是'双脚离地'的吗？"
                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Yes",
                            "zh": "是的"
                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "But , necessary？",
                            "zh": "但，重要吗？"
                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Trust me",
                            "zh": "相信我"
                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SHOUT",
                        "Lines": {
                            "en": "ggfyyw's blover will definitely blow away the black hole!",
                            "zh": "ggfyyw的三叶草一定能将黑洞吹走的！"
                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": ".......",
                            "zh": "。。。。。。"
                        },
                        "Delay": 0.3
                    }
                ]
            }
