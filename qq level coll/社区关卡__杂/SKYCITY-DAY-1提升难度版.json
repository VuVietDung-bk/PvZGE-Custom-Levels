    { 
      "objclass": "NarrativeProperties",
      "aliases": [
        "SKYCITY_1_INTRO"
      ],
      "objdata": {
        "AutoAdvance": true,
        "DelayBetweenLines": 1.5,
        "Flow": [
            {
                "Character": "crazydave",
                "Action": "NPC_ENTER",
                "Delay": 0.5
            },
            {
                "Character": "winnie",
                "Action": "NPC_ENTER",
                "Delay": 0.5
            },
            {
                "Character": "crazydave",
                "Action": "SAY",
                "Lines": {
                    "en": "It's so cold, where is this?",
                    "zh": "好冷，这是哪里？"
                },
                "Delay": 0.3
            },
            {
              "Character": "crazydave",
              "Action": "SAY",
              "Lines": {
                  "en": "The wind here is so strong that I can't keep my eyes open",
                  "zh": "这里的风好大，我的眼睛都睁不开了"
              },
              "Delay": 0.3
            },
            {
                "Character": "winnie",
                "Action": "TIRED",
                "Lines": {
                    "en": "We are now at a high altitude of 114,514 meters above the ground",
                    "zh": "我们现在位于距地面114514米处的高空"
                },
                "Delay": 0.3
            },
            {
                "Character": "crazydave",
                "Action": "SHOUT",
                "Lines": {
                    "en": "What?! Are you trying to stink me out (sad)?",
                    "zh": "什么？！你这家伙是想臭死我吗（悲）"
                },
                "Delay": 0.3
            },            
            {
              "Character": "winnie",
              "Action": "TIRED",
              "Lines": {
                  "en": "To be honest, I want it very much, even nine-tenths.",
                  "zh": "说实话，我十分甚至九分地想"
              },
              "Delay": 0.3
          },           
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
                "en": "It doesn't look like there will be any tacos here...",
                "zh": "这里看起来不像是会有玉米卷的样子......"
            },
            "Delay": 0.3
          },            
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
                "en": "Maybe, but it seems we can get a 'new type' of Peashooter.",
                "zh": "也许吧，但是我们似乎可以得到一种“新型”豌豆射手"
            },
            "Delay": 0.3
        },            
        {
          "Character": "crazydave",
          "Action": "SHOUT",
          "Lines": {
              "en": "That's really exciting, I think I might be able to add it to the taco.",
              "zh": "那真是太令人振奋了，我想我也许可以把它加到玉米卷里"
          },
          "Delay": 0.3
        },          
        {
          "Character": "winnie",
          "Action": "TIRED",
          "Lines": {
              "en": "...",
              "zh": "......"
          },
          "Delay": 0.3
        },        
        {
          "Character": "winnie",
          "Action": "TIRED",
          "Lines": {
              "en": "But, user Dave, since you like eating tacos so much, why don't you go buy another one?",
              "zh": "不过，用户戴夫，既然你这么喜欢吃玉米卷，为什么你不去再买一个呢？"
          },
          "Delay": 0.3
        }
        ]
      }
    },
