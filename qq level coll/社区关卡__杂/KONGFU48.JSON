            "objdata": {
                "Flow": [
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Upon a time.",
                            "zh": "从前有座山，山中有座庙。"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "There is a chi master.",
                            "zh": "庙中有一位气功大师。"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "He will save zombies in danger.",
                            "zh": "他会拯救僵尸们于水火之中。"
                        }
                    }
                ]
            }
        },
      {
            "objclass": "NarrativeProperties",
            "aliases": [
                "KONGFU_48_OUTRO"
            ],
            "objdata": {
                "Flow": [
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "That is unblievable!",
                            "zh": "难以置信!"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "We do that.",
                            "zh": "我们击败他了。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "User Dave,the ending is coming.",
                            "zh": "用户戴夫，这里的旅途结束了。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "It seems that there is no corn tortilla.",
                            "zh": "看来这个时空没有玉米卷。"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Bad...none can help me get your brain in this timeline.",
                            "zh": "可恶...没人给我交房租了。"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "But.",
                            "zh": "但别得意。"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "We will meet again,the sky is the destination.",
                            "zh": "我们还会再见面,天空即为极限。"
                        }
                    }
                ]
            }
