                        "Lines": {
                            "en": "Dave,I have to say that I have felt a pull towards Zomboss recently...",
                            "zh": "8888"
                        },
                        "Delay": 0.3
                    },
                     {
                        "Character": "crazydave",
                        "Action": "SAY",
