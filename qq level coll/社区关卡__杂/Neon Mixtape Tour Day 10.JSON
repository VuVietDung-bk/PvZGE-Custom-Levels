                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "It does suck.Where are my pants??",
                            "zh": "我"
                        },
                        "Delay": 0.3
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "No time for your dirty pants.We shouldn't stay in this musical dimension for even another measly day.I think the blackhole is the last warning.Time to skedaddle!",
                            "zh": "8888"
                        },
                        "Delay": 0.3
