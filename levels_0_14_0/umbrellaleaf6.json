        "Flow": [
          {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "crazydave",
            "Action": "TIRED",
            "Lines": {
              "en": "Vase can be used to store plants for when you need them most.",
              "zh": "罐子可以用来存植物，以备不时之需。"
            }
          },
          {
            "Character": "crazydave",
            "Action": "TIRED",
            "Lines": {
              "en": "See,those vases over there hold 3 Umbrella Leaves I saved earlier.",
              "zh": "看，那边的罐子里有我之前存的3株伞叶。"
            }
          },
          {
            "Character": "crazydave",
            "Action": "NPC_EXIT"
          },
          {
            "Character": "winnie",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
              "en": "Dr.Zomboss has sent a bunch of Bug Bot Imps to follow the missiles in their attack.",
              "zh": "僵尸博士派了一队机械虫小鬼跟随导弹进攻。"
            }
          },
          {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
              "en": "That means wherever the missiles land is exactly where the Bug Bot Imps will strike.",
              "zh": "也就是说，导弹的落点就是机械虫小鬼们的进攻位置。"
            }
          }
        ]
      }
