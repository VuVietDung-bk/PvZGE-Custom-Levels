     {
            "objclass": "NarrativeProperties",
            "aliases": [
                "EIGHTIES_35_INTRO"
            ],
            "objdata": {
                "Flow": [
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                     {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Dave,my sensor detect...a sudden drop in luminosity levels !",
                            "zh": "1"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "Bwah??You mean somepony turned off the sun ?! On our First Day To Equestria ?!",
                            "zh": "w！"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "I am surprised by the hospitality of ponies here.",
                            "zh": "w！"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Negative.It seems an ancient alicorn has returned and shrouded the land in eternal night...",
                            "zh": "1"
                        }
                    },
                     {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "It is said that her name is Nightmare Moon.She intends to plunge Equestira into darkness out of revenge.",
                            "zh": "1"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "It's time to show those ponies the power of My SunProducers!That Neighmare Moon will get her ass 'fucked'.",
                            "zh": "w！"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Let me do this job !",
                            "zh": "1"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "NPC_EXIT"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_EXIT"
                    }
                ]
            }
        },
        {
            "objclass": "NarrativeProperties",
            "aliases": [
                "C_OUTRO"
            ],
            "objdata": {
                "Flow": [
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                     {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Wow,that was close! Can we now have our party with Mane 6?Pinkie Pie is calling us !!!",
                            "zh": "w！"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Not so fast.The crisis isn't over.The Nightmare Moon hasn't been defeated.We have merely suppressed her for the time being.",
                            "zh": "1"
                        }
                    },
                                        {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "We have to prepare for our journey to the Everfree Forest to get the Elements Of Harmony,harnessing their power to whup and vanquish the Nightmare Moon.",
                            "zh": "1"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "EXCITED",
                        "Lines": {
                            "en": "How about getting her stuffed with TACOS!!!",
                            "zh": "w！"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "NPC_EXIT"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_EXIT"
                    }
                ]
            }
        },
