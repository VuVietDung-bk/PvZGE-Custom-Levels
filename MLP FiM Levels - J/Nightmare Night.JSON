     {
            "objclass": "NarrativeProperties",
            "aliases": [
                "NI_INTRO"
            ],
            "objdata": {
                "Flow": [
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                     {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": " Sensors confirm Today is the favourite festival in Ponyville, Dave. It’s Nightmare Night—ponies are wearing costumes and sharing candy!",
                            "zh": "1"
                        }
                    },
                                        {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Bwahaha! Nightmare Night! Costumes! Candy! Count me in!",
                            "zh": "w！"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "The Mane Six are already out celebrating.Twilight’s dressed as Starswirl the Bearded,.Pinkie Pie’s in a chicken costume.",
                            "zh": "1"
                        }
                    },
 {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Applejack’s running the apple-bobbing and pumpkin toss booths. Rainbow Dash is pranking ponies with thunderclouds again.",
                            "zh": "1"
                        }
                    },
 {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Just enjoy the night, Dave. Even Princess Luna’s here—trying to have fun without scaring everypony.",
                            "zh": "1"
                        }
                    },
                     {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": " Then it’s settled! I’ll hand out candy, dance with ponies, and maybe teach Luna the Zombie Shuffle!",
                            "zh": "w！"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "NPC_EXIT"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "NPC_EXIT"
                    }
                ]
            }
        },
