    		"objclass": "NarrativeProperties",
			"objdata": {
				"Flow": [
					{
						"Character": "crazydave",
						"Action": "NPC_ENTER"
					},
					{
						"Character": "winnie",
						"Action": "NPC_ENTER"
					},
					{
						"Character": "crazydave",
						"Action": "SAY",
						"Lines": {
							"en": "Penny, what's going on? Why are we here?",
							"zh": "Penny, what's going on? Why are we here?"
						}
					},
					{
						"Character": "winnie",
						"Action": "SAY",
						"Lines": {
							"en": "We appear to have fallen into an unstable time rift, user Dave.",
							"zh": "We appear to have fallen into an unstable time rift, user Dave."
						}
					},
					{
						"Character": "winnie",
						"Action": "SAY",
						"Lines": {
							"en": "The temporal integrity of this sector is compromised. This rift may fall apart at any moment.",
							"zh": "The temporal integrity of this sector is compromised. This rift may fall apart at any moment."
						}
					},
					{
						"Character": "winnie",
						"Action": "SAY",
						"Lines": {
							"en": "The flow of time has become unpredictable, the clock may turn back on us trying to escape.",
							"zh": "The flow of time has become unpredictable, the clock may turn back on us trying to escape."
						}
					},
					{
						"Character": "crazydave",
						"Action": "SAY",
						"Lines": {
							"en": "Well that doesn't sound good.",
							"zh": "Well that doesn't sound good."
						}
					},
					{
						"Character": "winnie",
						"Action": "SAY",
						"Lines": {
							"en": "I cannot warp us out of here while the zombies attack.",
							"zh": "I cannot warp us out of here while the zombies attack."
						}
					},
					{
						"Character": "winnie",
						"Action": "SAY",
						"Lines": {
							"en": "We must deal with the zombie onslaught before the timeline collapses. Let's hope the temporal instabilities don't set us back too much.",
							"zh": "We must deal with the zombie onslaught before the timeline collapses. Let's hope the temporal instabilities don't set us back too much."
						}
					}
				]
			}
		},
