            ],
            "objclass": "NarrativeProperties",
            "objdata": {
                "Flow": [
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
					{
                        "Character": "crazydave",
                        "Action": "PLAYFUL",
                        "Lines": {
                            "en": "Hey there neighbor!",
                            "zh": "我刚把凳子焐热。"
                        }
                    },
					{
                        "Character": "crazydave",
                        "Action": "PLAYFUL",
                        "Lines": {
                            "en": "Seems like the boss man sent a bunch of no good zombos our way.",
                            "zh": "我刚把凳子焐热。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "PLAYFUL",
                        "Lines": {
                            "en": "Don't worry though!",
                            "zh": "我刚把凳子焐热。"
                      }
                    },
  					{
                        "Character": "crazydave",
                        "Action": "PLAYFUL",
                        "Lines": {
                            "en": "I brought along some good ol' Resistant Radishes to help us!",
                            "zh": "我刚把凳子焐热。"
                        }
                    },              
                    {
                        "Character": "crazydave",
                        "Action": "PLAYFUL",
                        "Lines": {
                            "en": "The bad news is that I only brought five.",
                            "zh": "我刚把凳子焐热。"
                      }
                    },                
  					{
                        "Character": "crazydave",
                        "Action": "PLAYFUL",
                        "Lines": {
                            "en": "So make sure nothing happens to em, and you'll be fine!",
                            "zh": "我刚把凳子焐热。"
                        }
                    }                
                ]
            }
