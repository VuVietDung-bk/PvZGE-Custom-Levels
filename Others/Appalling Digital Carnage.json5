	{
      "aliases": [
        "INTRO"
      ],
      "objclass": "NarrativeProperties",
      "objdata": {
        "Flow": [
		  {
            "Character": "crazydave",
            "Action": "NPC_ENTER"
          },
          {
            "Character": "crazydave",
            "Action": "SAY",
            "Lines": {
              "en": "Woah.",
              "zh": "如果想使用道具，可以用金币购买哦！"
            }
          },
		  {
            "Character": "crazydave",
            "Action": "EXCITED",
            "Lines": {
              "en": "This isn't our good ol' Far Future. Penny, where are we?",
              "zh": "如果想使用道具，可以用金币购买哦！"
            }
          },
		  {
            "Character": "winnie",
            "Action": "NPC_ENTER"
          },
		  {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "This is unusual. My radar cannot pick up our coordinates.",
              "zh": "如果想使用道具，可以用金币购买哦！"
            }
          },
		  {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "It seems like we have been sucked into a strange digital world somehow.",
              "zh": "如果想使用道具，可以用金币购买哦！"
            }
          },
		  {
            "Character": "crazydave",
            "Action": "PLAYFUL",
            "Lines": {
              "en": "Oooooh. So this is what that suspicious arcade machine does.",
              "zh": "如果想使用道具，可以用金币购买哦！"
            }
          },
		  {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
              "en": "...",
              "zh": "如果想使用道具，可以用金币购买哦！"
            }
          },
		  {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
              "en": "...User Dave, have you been going out pressing random arcade machines, again?",
              "zh": "如果想使用道具，可以用金币购买哦！"
            }
          },
		  {
            "Character": "crazydave",
            "Action": "PLAYFUL",
            "Lines": {
              "en": "Yeah?",
              "zh": "如果想使用道具，可以用金币购买哦！"
            }
          },
		  {
            "Character": "winnie",
            "Action": "TIRED",
            "Lines": {
              "en": "We will have a talk later, User Dave. For now, my scanner has picked up hostile movements towards our digital house.",
              "zh": "如果想使用道具，可以用金币购买哦！"
            }
          },
		  {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "Neighbour, please defend our house while I calculate our way out of here.",
              "zh": "如果想使用道具，可以用金币购买哦！"
            }
          },
		  {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "User Dave, you just... stay put.",
              "zh": "如果想使用道具，可以用金币购买哦！"
            }
          },
        ]
      }
    },
