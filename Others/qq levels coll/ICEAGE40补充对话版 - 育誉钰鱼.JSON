            "objdata": {
                "Flow": [
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Coldness let your plants completely be icy.And it let my plan completely be certain.",
                            "zh": "寒冷让你的植物彻底冻僵，让我的计划彻底'凝固成型'。"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Your wrong timetrip should have stopped along time ago.",
                            "zh": "你们无厘头的时空乱逛早该停下了。"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Today,Zombot Tuskmaster 10,000 BC 2.0 will stop your mistake by the coldest storm!",
                            "zh": "现在，就让獠牙征服者2.0用最寒冷的风暴终结你的闹剧！"
                        }
                    }
                ]
            }
        },
      {
            "objclass": "NarrativeProperties",
            "aliases": [
                "ICEAGE_40_OUTRO"
            ],
            "objdata": {
                "Flow": [
                    {
                        "Character": "crazydave",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Finally,we are winners.",
                            "zh": "终于结束了。"
                        }
                    },
                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "It seems that I do not have to sleep with Hot Potato.",
                            "zh": "看来今晚不用抱着烤马铃薯睡觉了。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "User Dave,I unbelieve that you can sleep comfortably.",
                            "zh": "用户戴夫，我可不认为你可以安然入睡。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "This timeline have no manace now.We need to travel to other timeline now.",
                            "zh": "这个时间线的威胁已经解除了，该前往下一个时空了。"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "I will never fail again!",
                            "zh": "下次...下次我不会再失败了！"
                        }
                    },
                    {
                        "Character": "zombossicon",
                        "Action": "SAY",
                        "Lines": {
                            "en": "...",
                            "zh": "给我等着"
                        }
                    }
                ]
            }
