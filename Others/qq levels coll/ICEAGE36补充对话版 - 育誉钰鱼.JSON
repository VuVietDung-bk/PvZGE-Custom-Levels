                    {
                        "Character": "crazydave",
                        "Action": "SAY",
                        "Lines": {
                            "en": "Wait,I seem to find that our mowers were lost by the ice storm.",
                            "zh": "等一下，我们可爱的小水獭好像被暴风雪卷走了。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "NPC_ENTER"
                    },
                    {
                        "Character": "winnie",
                        "Action": "SAY",
                        "Lines": {
                            "en": "They can not continue to help us.We have no these friends in the timeline forever.",
                            "zh": "这条时间线将不再拥有我们的那些盟友了。"
                        }
                    },
                    {
                        "Character": "winnie",
                        "Action": "TIRED",
                        "Lines": {
                            "en": "That means that we have to protect our plants and front hard",
                            "zh": "这意味着我们必须坚守防线，不能有任何松懈。"
                        }
                    },
                ]
