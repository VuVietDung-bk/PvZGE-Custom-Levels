            "Lines": {
              "en": "Welcome to Trampler's Trail!",
              "zh": "如果想使用道具，可以用金币购买哦！"
            }
          },
          {
            "Character": "winnie",
            "Action": "EXCITED",
            "Lines": {
              "en": "*Most* zombies will follow the designated path. Plant your defence accordingly.",
              "zh": "如果想使用道具，可以用金币购买哦！"
            }
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "You may also use sun producers.",
              "zh": "如果想使用道具，可以用金币购买哦！"
            }
          },
          {
            "Character": "winnie",
            "Action": "SAY",
            "Lines": {
              "en": "And finally, look out for ambushes.",
              "zh": "如果想使用道具，可以用金币购买哦！"
            }
          },
          {
            "Character": "winnie",
            "Action": "PLAYFUL",
            "Lines": {
              "en": "Good luck!",
              "zh": "如果想使用道具，可以用金币购买哦！"
            }
          },
        ]
