    "objclass": "NarrativeProperties",
    "objdata": {
        "Flow": [
        {
                "Character": "winnie",
                "Action": "NPC_ENTER"
            },
            {
                "Character": "crazydave",
                "Action": "NPC_ENTER"
            },
            {
                "Character": "crazydave",
                "Action": "SAY",
                "Lines": {
                    "en": "Have we been here before, Penny?",
                    "zh": "???"
                }
            },
            {
                "Character": "crazydave",
                "Action": "EXCITED",
                "Lines": {
                    "en": "I don't recognize this place!",
                    "zh": "???"
                }
            },
            {
                "Character": "winnie",
                "Action": "TIRED",
                "Lines": {
                    "en": "Kong Fu Temple... It's a complicated matter.",
                    "zh": "???"
                }
            },
            {
                "Character": "winnie",
                "Action": "SAY",
                "Lines": {
                    "en": "Let's just say you have been here.",
                    "zh": "???"
                }
            },
            {
                "Character": "crazydave",
                "Action": "EXCITED",
                "Lines": {
                    "en": "So that explains how I learned Chinese!",
                    "zh": "???"
                }
            },
            {
                "Character": "crazydave",
                "Action": "SAY",
                "Lines": {
                    "en": "为什么这辆矿车上放着一颗荔枝？",
                    "zh": "Why is this Lychee on a railcart?"
                }
            },
            {
                "Character": "winnie",
                "Action": "SAY",
                "Lines": {
                    "en": "Impressive. Either way, this is Wallychee, the next plant we have to rescue.",
                    "zh": "???"
                }
            },
            {
                "Character": "crazydave",
                "Action": "EXCITED",
                "Lines": {
                    "en": "那就是“墙荔枝”，明白了！",
                    "zh": "That is a Wallychee, understood!"
                }
            },
            {
                "Character": "winnie",
                "Action": "EXCITED",
                "Lines": {
                    "en": "You can switch back to English, User Dave. Will make it easier for our neighbor to understand.",
                    "zh": "???"
                }
            }
        ]
      }
